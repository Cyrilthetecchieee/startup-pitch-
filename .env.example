# FitSphere Environment Configuration
# Default is configured to connect seamlessly to Firebase Emulators

VITE_FIREBASE_API_KEY=demo-fitsphere-api-key
VITE_FIREBASE_AUTH_DOMAIN=demo-fitsphere.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=demo-fitsphere
VITE_FIREBASE_STORAGE_BUCKET=demo-fitsphere.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789012
VITE_FIREBASE_APP_ID=1:123456789012:web:abcdef1234567890

# Use Firebase Local Emulators (set to "true" for local dev & testing)
VITE_USE_FIREBASE_EMULATOR=true
VITE_EMULATOR_AUTH_PORT=9099
VITE_EMULATOR_FIRESTORE_PORT=8080
